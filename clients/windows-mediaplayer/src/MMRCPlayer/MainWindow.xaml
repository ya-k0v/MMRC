<Window x:Class="MMRCPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MMRC Player"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Normal"
        ShowInTaskbar="True"
        Topmost="False"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Grid x:Name="MainGrid" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="VideoGrid" Grid.Row="0" Background="Black">

            <!-- Brand Background (Audio logo) -->
            <Image x:Name="BrandBg"
                   Stretch="Uniform"
                   MaxWidth="128" MaxHeight="128"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="10" />

            <!-- Primary Image -->
            <Image x:Name="ImagePrimary"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="10" />

            <!-- Buffer Image (for crossfade) -->
            <Image x:Name="ImageBuffer"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="10" />

            <!-- Loading Indicator -->
            <Border x:Name="LoadingIndicator"
                    Width="48" Height="48"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#80000000"
                    CornerRadius="24"
                    Panel.ZIndex="20">
                <Border.Effect>
                    <BlurEffect Radius="4" />
                </Border.Effect>
            </Border>

        </Grid>

        <!-- Status Text -->
        <TextBlock x:Name="StatusText"
                   Foreground="#AAFFFFFF"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,16"
                   Visibility="Collapsed"
                   Text=""
                   Panel.ZIndex="30" />

    </Grid>
</Window>
