<Window x:Class="MMRCPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MMRC Player"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Normal"
        ShowInTaskbar="True"
        Topmost="False"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Grid x:Name="MainGrid" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Black">

            <!-- Primary Video Player (HwndHost - always on top of WPF content when visible) -->
            <vlc:VideoView x:Name="VideoPrimaryView"
                            Background="Black"
                            Visibility="Collapsed" />

            <!-- Buffer Video Player (for crossfade) -->
            <vlc:VideoView x:Name="VideoBufferView"
                            Background="Black"
                            Visibility="Collapsed" />

            <!-- Brand Background (Audio logo) - must be after VideoViews to render on top when they're collapsed -->
            <Image x:Name="BrandBg"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="10" />

            <!-- Primary Image -->
            <Image x:Name="ImagePrimary"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="10" />

            <!-- Buffer Image (for crossfade) -->
            <Image x:Name="ImageBuffer"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="10" />

            <!-- Loading Indicator -->
            <Border x:Name="LoadingIndicator"
                    Width="48" Height="48"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#80000000"
                    CornerRadius="24"
                    Panel.ZIndex="20">
                <Border.Effect>
                    <BlurEffect Radius="4" />
                </Border.Effect>
            </Border>

            <!-- Status Text -->
            <TextBlock x:Name="StatusText"
                       Foreground="#AAFFFFFF"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,16"
                       Visibility="Collapsed"
                       Text=""
                       Panel.ZIndex="30" />

        </Grid>
    </Grid>
</Window>
