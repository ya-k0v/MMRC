<Window x:Class="MMRCPlayer.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="True"
        SizeToContent="WidthAndHeight"
        MouseDoubleClick="OverlayWindow_MouseDoubleClick"
        Left="-10000" Top="-10000">

    <Border Margin="0,0,2,2">
        <TextBlock x:Name="OverlayText"
                   Foreground="#B3FFFFFF"
                   FontSize="9"
                   Text=""
                   Opacity="0.7">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>
    </Border>
</Window>
