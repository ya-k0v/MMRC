# syntax=docker/dockerfile:1

FROM node:22-slim

ARG APP_VERSION=3.5.0
LABEL maintainer="ya-k0v"
LABEL description="MMRC Streamer — ffmpeg with health endpoint"
LABEL version=${APP_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

COPY src/streamer/streamer-server.js ./streamer-server.js

EXPOSE 3001

CMD ["node", "streamer-server.js"]
