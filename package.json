{
  "name": "mmrc",
  "version": "3.4.0",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:ci",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:ci": "bash ./scripts/ci-test.sh",
    "doctor:start": "node scripts/check-startup-compat.js",
    "migrate-db": "node src/database/migrate.js",
    "storage:migrate": "node src/storage/migrate.js",
    "mcp": "SILENT_CONSOLE=true node dev/mcp-server.js",
    "post-pull:sync": "bash ./scripts/post-pull-sync.sh",
    "setup-hooks": "bash ./scripts/setup-git-hooks.sh",
    "install-git-hooks": "npm run setup-hooks --silent",
    "sync-version": "node scripts/sync-version-from-json.js",
    "postinstall": "npm run sync-version --silent && npm run setup-hooks --silent || true",
    "ytdlp:install": "bash ./scripts/install-yt-dlp-local.sh",
    "ytdlp:version": "./bin/yt-dlp --version"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1069.0",
    "@bull-board/api": "^8.0.0",
    "@bull-board/express": "^8.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.1",
    "bull": "^4.16.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.3.2",
    "file-type": "^22.0.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^8.1.8",
    "mime": "^4.0.4",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "sanitize-filename": "^1.6.4",
    "sharp": "^0.35.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
