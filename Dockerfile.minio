FROM --platform=$BUILDPLATFORM golang:1.24.13-alpine3.23 AS build

ARG TARGETOS
ARG TARGETARCH
ARG MINIO_COMMIT=7aac2a2c5b7c882e68c1ce017d8256be2feea27f
ARG MC_COMMIT=77f82e18b5401a65958f1619df6ebb994634bd88

ENV CGO_ENABLED=0 GOBIN=/out

RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go install -trimpath -ldflags="-s -w" "github.com/minio/minio@${MINIO_COMMIT}" \
    && GOOS=${TARGETOS} GOARCH=${TARGETARCH} go install -trimpath -ldflags="-s -w" "github.com/minio/mc@${MC_COMMIT}"

FROM alpine:3.23

ARG MINIO_COMMIT=7aac2a2c5b7c882e68c1ce017d8256be2feea27f
ARG MC_COMMIT=77f82e18b5401a65958f1619df6ebb994634bd88

LABEL org.opencontainers.image.title="MinIO Community with mc" \
    org.opencontainers.image.licenses="AGPL-3.0" \
    org.opencontainers.image.source="https://github.com/minio/minio" \
    org.opencontainers.image.revision="${MINIO_COMMIT}" \
    io.mmrc.mc.source="https://github.com/minio/mc" \
    io.mmrc.mc.revision="${MC_COMMIT}"

RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata

COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /out/mc /usr/local/bin/mc

EXPOSE 9000 9001
VOLUME ["/data"]

ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
